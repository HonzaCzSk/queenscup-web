---
import { t, getLang } from "../i18n/index";
import type { Lang } from "../i18n/index";
import { getPartners } from "../lib/queries";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
  description?: string;
  lang?: string;
  activePage?: string;
  activeCategory?: string;
}

const {
  title,
  description = "Mezinárodní minibasketbalový turnaj – Hradec Králové",
  lang = "cs",
  activePage = "",
  activeCategory = "u11",
} = Astro.props;

const locale = getLang(lang);
const tr = t(locale);

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=60, s-maxage=600, stale-while-revalidate=120"
);

const currentPath = Astro.url.pathname;
const currentCat = Astro.url.searchParams.get("cat") ?? activeCategory ?? "u11";
const catParam = `?cat=${currentCat}`;

const tournamentName =
  currentCat === "u13" ? "V4 Basketball Queens Cup" : "Basketball Queens Cup";

// Mapa českých cest na EN/PL ekvivalenty
const pathMap: Record<string, { en: string; pl: string }> = {
  "/": { en: "/en/", pl: "/pl/" },
  "/rozpis": { en: "/en/schedule", pl: "/pl/schedule" },
  "/vysledky": { en: "/en/results", pl: "/pl/results" },
  "/pavouk": { en: "/en/bracket", pl: "/pl/bracket" },
  "/tymy": { en: "/en/teams", pl: "/pl/teams" },
  "/info": { en: "/en/info", pl: "/pl/info" },
  "/kontakty": { en: "/en/contacts", pl: "/pl/contacts" },
  "/fotky": { en: "/en/photos", pl: "/pl/photos" },
};

// Normalizuj aktuální cestu na českou verzi
const csPath =
  currentPath
    .replace(/\/$/, "")
    .replace(/^\/en/, "")
    .replace(/^\/pl/, "")
    .replace(/\/(schedule|harmonogram)$/, "/rozpis")
    .replace(/\/(results|wyniki)$/, "/vysledky")
    .replace(/\/(bracket|drabinka)$/, "/pavouk")
    .replace(/\/(teams|druzyny)$/, "/tymy")
    .replace(/\/(contacts|kontakt)$/, "/kontakty")
    .replace(/\/(photos|zdjecia)$/, "/fotky") || "/";

const mapped = pathMap[csPath] ?? { en: "/en" + csPath, pl: "/pl" + csPath };

const langUrls: Record<Lang, string> = {
  cs: (csPath || "/") + catParam,
  en: mapped.en + catParam,
  pl: mapped.pl + catParam,
};

const partners = await getPartners();
const generalPartners = partners.filter((p: any) => p.level === "general");
const mainPartners = partners.filter((p: any) => p.level === "main");
const regularPartners = partners.filter((p: any) => p.level === "partner");
const mediaPartners = partners.filter((p: any) => p.level === "media");
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | {tournamentName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | ${tournamentName}`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={tournamentName} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/flag-icons@7.2.3/css/flag-icons.min.css"
    />

    <!-- Prevent theme flash -->
    <script is:inline>
      (function () {
        const saved = localStorage.getItem("theme");
        const sys = window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
        document.documentElement.setAttribute("data-theme", saved || sys);
      })();
    </script>
  </head>

  <body>
    <!-- TOPBAR -->
    <div class="topbar">
      <div class="wrap topbar__inner">
        <div class="brand">
          <span class="brand__dot"></span>
          <a class="brand__name" href={lang === "cs" ? "/" : `/${lang}/`}
            >{tournamentName}</a
          >
        </div>

        <div class="topright">
          <!-- Přepínač kategorií -->
          <div class="cattabs">
            <a
              class={`cattab ${activeCategory === "u11" ? "is-active" : ""}`}
              href={`${currentPath}?cat=u11`}
            >
              {tr.categories.u11}
            </a>
            <a
              class={`cattab ${activeCategory === "u12" ? "is-active" : ""}`}
              href={`${currentPath}?cat=u12`}
            >
              {tr.categories.u12}
            </a>
            <a
              class={`cattab ${activeCategory === "u13" ? "is-active" : ""}`}
              href={`${currentPath}?cat=u13`}
            >
              {tr.categories.u13}
            </a>
          </div>

          <!-- Přepínač jazyků -->
          <div class="langswitch">
            <a
              class={`langbtn ${lang === "cs" ? "is-active" : ""}`}
              href={langUrls.cs}
              aria-label="Čeština">CZ</a
            >
            <a
              class={`langbtn ${lang === "en" ? "is-active" : ""}`}
              href={langUrls.en}
              aria-label="English">EN</a
            >
            <a
              class={`langbtn ${lang === "pl" ? "is-active" : ""}`}
              href={langUrls.pl}
              aria-label="Polski">PL</a
            >
          </div>

          <!-- Dark mode toggle -->
          <div
            class="theme-toggle theme-toggle--topbar"
            id="themeToggle"
            role="group"
            aria-label="Barevný motiv"
          >
            <button class="theme-seg" data-mode="dark" type="button">
              <span class="theme-seg__label">D</span>
              <span class="theme-seg__tip">Dark</span>
            </button>
            <button class="theme-seg" data-mode="light" type="button">
              <span class="theme-seg__label">L</span>
              <span class="theme-seg__tip">Light</span>
            </button>
            <button class="theme-seg" data-mode="system" type="button">
              <span class="theme-seg__label">S</span>
              <span class="theme-seg__tip">System</span>
            </button>
          </div>

          <!-- Hamburger -->
          <button
            class="menubtn"
            id="menuToggle"
            type="button"
            aria-label="Otevřít menu"
          >
            <svg
              width="16"
              height="12"
              viewBox="0 0 16 12"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect x="0" y="0" width="16" height="2" rx="1" fill="white"
              ></rect>
              <rect x="0" y="5" width="16" height="2" rx="1" fill="white"
              ></rect>
              <rect x="5" y="10" width="11" height="2" rx="1" fill="white"
              ></rect>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- MOBILE MENU -->
    <div class="menu" id="mobileMenu" aria-hidden="true">
      <div class="menu__backdrop" data-close></div>
      <div
        class="menu__panel"
        role="dialog"
        aria-modal="true"
        aria-label="Menu"
      >
        <div class="menu__head">
          <div class="menu__title">Menu</div>
          <button
            class="menu__close"
            type="button"
            data-close
            aria-label="Zavřít menu">✕</button
          >
        </div>
        <div class="menu__links">
          <a
            class={`menu__link ${activePage === "home" ? "is-active" : ""}`}
            href={lang === "cs" ? "/" : `/${lang}/`}
          >
            <span class="menu__link__icon">🏠</span>{tr.nav.home}</a
          >
          <a
            class={`menu__link ${activePage === "schedule" ? "is-active" : ""}`}
            href={lang === "cs" ? "/rozpis" : `/${lang}/schedule`}
          >
            <span class="menu__link__icon">📅</span>{tr.nav.schedule}</a
          >
          <a
            class={`menu__link ${activePage === "results" ? "is-active" : ""}`}
            href={lang === "cs" ? "/vysledky" : `/${lang}/results`}
          >
            <span class="menu__link__icon">🏀</span>{tr.nav.results}</a
          >
          <a
            class={`menu__link ${activePage === "bracket" ? "is-active" : ""}`}
            href={lang === "cs" ? "/pavouk" : `/${lang}/bracket`}
          >
            <span class="menu__link__icon">🏆</span>{tr.nav.bracket}</a
          >
          <a
            class={`menu__link ${activePage === "teams" ? "is-active" : ""}`}
            href={lang === "cs" ? "/tymy" : `/${lang}/teams`}
          >
            <span class="menu__link__icon">👥</span>{tr.nav.teams}</a
          >
          <a
            class={`menu__link ${activePage === "info" ? "is-active" : ""}`}
            href={lang === "cs" ? "/info" : `/${lang}/info`}
          >
            <span class="menu__link__icon">ℹ️</span>{tr.nav.info}</a
          >
          <a
            class={`menu__link ${activePage === "contacts" ? "is-active" : ""}`}
            href={lang === "cs" ? "/kontakty" : `/${lang}/contacts`}
          >
            <span class="menu__link__icon">📞</span>{tr.nav.contacts}</a
          >
          <a
            class={`menu__link ${activePage === "photos" ? "is-active" : ""}`}
            href={lang === "cs" ? "/fotky" : `/${lang}/photos`}
          >
            <span class="menu__link__icon">📷</span>{tr.nav.photos}</a
          >
        </div>
        <!-- Jazyk + theme v menu -->
        <div class="menu__lang">
          <a
            class={`langbtn ${lang === "cs" ? "is-active" : ""}`}
            href={langUrls.cs}>CZ</a
          >
          <a
            class={`langbtn ${lang === "en" ? "is-active" : ""}`}
            href={langUrls.en}>EN</a
          >
          <a
            class={`langbtn ${lang === "pl" ? "is-active" : ""}`}
            href={langUrls.pl}>PL</a
          >
          <div class="menu__lang__sep"></div>
          <div
            class="theme-toggle theme-toggle--menu"
            role="group"
            aria-label="Barevný motiv"
          >
            <button class="theme-seg" data-mode="dark" type="button">
              <span class="theme-seg__label">D</span>
            </button>
            <button class="theme-seg" data-mode="light" type="button">
              <span class="theme-seg__label">L</span>
            </button>
            <button class="theme-seg" data-mode="system" type="button">
              <span class="theme-seg__label">S</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- NAV -->
    <nav class="nav">
      <div class="wrap nav__inner">
        <!-- Desktop NAV -->
        <a
          class={`nav__item ${activePage === "home" ? "is-active" : ""}`}
          href={lang === "cs" ? "/" : `/${lang}/`}>{tr.nav.home}</a
        >
        <a
          class={`nav__item ${activePage === "schedule" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/rozpis${catParam}`
            : `/${lang}/schedule${catParam}`}>{tr.nav.schedule}</a
        >
        <a
          class={`nav__item ${activePage === "results" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/vysledky${catParam}`
            : `/${lang}/results${catParam}`}>{tr.nav.results}</a
        >
        <a
          class={`nav__item ${activePage === "bracket" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/pavouk${catParam}`
            : `/${lang}/bracket${catParam}`}>{tr.nav.bracket}</a
        >
        <a
          class={`nav__item ${activePage === "teams" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/tymy${catParam}`
            : `/${lang}/teams${catParam}`}>{tr.nav.teams}</a
        >
        <a
          class={`nav__item ${activePage === "info" ? "is-active" : ""}`}
          href={lang === "cs" ? `/info${catParam}` : `/${lang}/info${catParam}`}
          >{tr.nav.info}</a
        >
        <a
          class={`nav__item ${activePage === "contacts" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/kontakty${catParam}`
            : `/${lang}/contacts${catParam}`}>{tr.nav.contacts}</a
        >
        <a
          class={`nav__item ${activePage === "photos" ? "is-active" : ""}`}
          href={lang === "cs"
            ? `/fotky${catParam}`
            : `/${lang}/photos${catParam}`}>{tr.nav.photos}</a
        >
      </div>
    </nav>

    <!-- UNDER CONSTRUCTION BANNER -->
    <div class="construction-banner">
      <div class="wrap construction-banner__inner">
        <span class="construction-banner__icon">⚠️</span>
        <span class="construction-banner__text">{tr.construction_notice}</span>
      </div>
    </div>

    <!-- OBSAH STRÁNKY -->
    <slot />

    <!-- FOOTER -->
    <footer class="footer">
      <div class="wrap footer__wrap">
        {
          partners.length > 0 && (
            <div class="partners">
              <div class="partners__title">{tr.home.partners_title}</div>

              {generalPartners.length > 0 && (
                <div>
                  <div class="partners__general-label">
                    {tr.partners.general}
                  </div>
                  <div class="partners__general">
                    {generalPartners.map((p: any) => (
                      <a
                        href={p.url ?? "#"}
                        class="partner"
                        target="_blank"
                        rel="noopener"
                        title={p.name}
                      >
                        {p.logo ? (
                          <img src={p.logo} alt={p.name} />
                        ) : (
                          <span>{p.name}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {mainPartners.length > 0 && (
                <div>
                  <div class="partners__section-label">
                    {tr.partners.main}
                  </div>
                  <div class="partners__row">
                    {mainPartners.map((p: any) => (
                      <a
                        href={p.url ?? "#"}
                        class="partner partner--main"
                        target="_blank"
                        rel="noopener"
                        title={p.name}
                      >
                        {p.logo ? (
                          <img src={p.logo} alt={p.name} />
                        ) : (
                          <span>{p.name}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {regularPartners.length > 0 && (
                <div>
                  <div class="partners__section-label">
                    {tr.partners.regular}
                  </div>
                  <div class="partners__row">
                    {regularPartners.map((p: any) => (
                      <a
                        href={p.url ?? "#"}
                        class="partner"
                        target="_blank"
                        rel="noopener"
                        title={p.name}
                      >
                        {p.logo ? (
                          <img src={p.logo} alt={p.name} />
                        ) : (
                          <span>{p.name}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              {mediaPartners.length > 0 && (
                <div>
                  <div class="partners__section-label">
                    {tr.partners.media}
                  </div>
                  <div class="partners__row">
                    {mediaPartners.map((p: any) => (
                      <a
                        href={p.url ?? "#"}
                        class="partner"
                        target="_blank"
                        rel="noopener"
                        title={p.name}
                      >
                        {p.logo ? (
                          <img src={p.logo} alt={p.name} />
                        ) : (
                          <span>{p.name}</span>
                        )}
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          )
        }
        <div class="footer__bar">
          <div class="footer__left-wrap">
            <div class="footer__left">
              {tr.footer.rights.replace("Queens Cup", tournamentName)}
            </div>
            {
              currentCat === "u13" && (
                <div class="eu-funding">
                  <a
                    href="https://www.visegradfund.org"
                    target="_blank"
                    rel="noopener"
                  >
                    <img
                      src="/assets/visegrad-logo.jpg"
                      alt="Visegrad Fund"
                      class="visegrad-logo"
                    />
                  </a>
                  <span class="eu-text">
                    This event is supported by the grant No. 12610107 of{" "}
                    <a
                      href="https://www.visegradfund.org"
                      target="_blank"
                      rel="noopener"
                      class="eu-link"
                    >
                      Visegrad funds.
                    </a>
                  </span>
                </div>
              )
            }
          </div>
          <div class="socialbar" aria-label="Sociální sítě">
            <a
              class="socialbtn"
              href="https://www.instagram.com/queens_cup_hk/"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <img src="/assets/social/instagram.svg" alt="Instagram" />
            </a>
            <a
              class="socialbtn socialbtn--tvcom"
              href="https://www.tvcom.cz/"
              target="_blank"
              rel="noopener"
              aria-label="TVcom"
            >
              <img src="/assets/social/tvcom.svg" alt="TVcom" />
            </a>
            <a
              class="socialbtn"
              href="https://www.hradeckelvice.cz/"
              target="_blank"
              rel="noopener"
              aria-label="Hradecké lvice"
            >
              <img src="/assets/social/lvice.svg" alt="Hradecké lvice" />
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- COOKIE NOTICE -->
    <div id="site-notice" role="region" aria-label={tr.cookies.label}>
      <div class="site-notice__inner">
        <div class="site-notice__icon">🍪</div>
        <div class="site-notice__text">
          <strong>{tr.cookies.title}</strong>
          <span>{tr.cookies.desc}</span>
        </div>
        <div class="site-notice__actions">
          <button class="notice-btn" id="cookie-accept" type="button">{tr.cookies.accept}</button>
        </div>
      </div>
    </div>

    <!-- SCRIPTS -->
    <script is:inline src="/assets/js/theme.js"></script>
    <script is:inline src="/assets/js/menu.js"></script>
    <script is:inline src="/assets/js/preferences.js"></script>

    <SpeedInsights />

    <!-- Vercel Analytics -->
    <script>
      import { inject } from "@vercel/analytics";
      inject();
    </script>
  </body>
</html>
