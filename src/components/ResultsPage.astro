---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { getMatches, getSettings } from "../lib/queries";
import { t, getLang } from "../i18n/index";
import type { Match } from "../lib/types";

interface Props {
  lang: string;
  cat: "u12" | "u13" | "u14";
}

const { lang, cat } = Astro.props;
const locale = getLang(lang);
const tr = t(locale);

const matches = await getMatches(cat);
const settings = await getSettings();
const showSchedule = settings?.showSchedule?.[cat] ?? true;

const den1 = matches.filter((m: any) => m.day === 1);
const den2 = matches.filter((m: any) => m.day === 2);
const den3 = matches.filter((m: any) => m.day === 3);

const courts: Record<string, string> = {
  court1: tr.venues.court1,
  court2: tr.venues.court2,
  sokol: tr.venues.sokol,
  gapa: tr.venues.gapa,
};

const matchTypes = tr.matchTypes as Record<string, string>;

const catLabels: Record<string, string> = {
  u12: tr.categories.u12_venue,
  u13: tr.categories.u13_venue,
  u14: tr.categories.u14_venue,
};

const dayLabels = {
  day1: tr.schedule.day1,
  day2: tr.schedule.day2,
  day3: tr.schedule.day3,
};

function formatTime(datetime: string) {
  if (!datetime) return "—";
  return new Date(datetime).toLocaleTimeString(
    locale === "cs" ? "cs-CZ" : locale === "pl" ? "pl-PL" : "en-US",
    { hour: "2-digit", minute: "2-digit", hour12: false, timeZone: "Europe/Prague" },
  );
}

function getRowClass(m: Match) {
  if (m.status === "live") return "is-live";
  if (m.status === "finished" || (m.scoreA != null && m.scoreB != null))
    return "is-fin";
  return "";
}

function getStatusBadge(m: Match, locale: string) {
  if (m.status === "live") return `<span class="badge badge--live">LIVE</span>`;
  if (m.status === "finished" || (m.scoreA != null && m.scoreB != null)) {
    return `<span class="badge badge--fin">${locale === "en" ? "FT" : locale === "pl" ? "KONIEC" : "KONEC"}</span>`;
  }
  return `<span class="badge">—</span>`;
}

function getScore(m: Match) {
  if (m.scoreA != null && m.scoreB != null) return `${m.scoreA} : ${m.scoreB}`;
  if (m.status === "live") return "0 : 0";
  return "—";
}

function getQuarters(m: Match) {
  if (!m.quarters || m.quarters.length === 0) return null;
  return m.quarters;
}
---

<Layout
  title={tr.results.title}
  activePage="results"
  activeCategory={cat}
  lang={lang}
>
  <main class="wrap">
    <section class="pagehead">
      <h1 class="h1">{tr.results.title}</h1>
      <p class="lead">{catLabels[cat]}</p>

      <!-- Live auto-refresh bar -->
      <div class="live-refresh-bar" id="liveRefreshBar">
        <div class="live-refresh-status">
          <span class="live-pulse"></span>
          <span class="live-status-text">{tr.results.auto_refresh_on}</span>
        </div>
        <div class="live-refresh-actions">
          <span class="live-refresh-time" id="liveRefreshTime">
            {tr.results.updated_at} <strong id="liveLastTime">—</strong>
          </span>
          <button type="button" class="btn btn--small btn--ghost live-refresh-btn" id="liveRefreshBtn">
            {tr.results.refresh_now}
          </button>
        </div>
      </div>
    </section>

    {
      !showSchedule ? (
        <section class="card" style="text-align: center; padding: 48px 24px;">
          <p style="font-size: 18px; font-weight: 700; opacity: 0.5;">
            {tr.results.results_upcoming}
          </p>
        </section>
      ) : (
        <>
          {[
            { label: dayLabels.day1, matches: den1 },
            { label: dayLabels.day2, matches: den2 },
            { label: dayLabels.day3, matches: den3 },
          ].map(
            ({ label, matches }) =>
              matches.length > 0 && (
                <section class="card" style="margin-bottom: 24px;">
                  <h2 class="h2">{label}</h2>
                  <div class="tablewrap">
                    <table class="schedule results">
                      <colgroup>
                        <col style="width: 75px;" />
                        <col style="width: 110px;" />
                        <col />
                        <col style="width: 110px;" />
                        <col style="width: 80px;" />
                      </colgroup>
                      <thead>
                        <tr>
                          <th>{tr.results.time}</th>
                          <th>{tr.results.hall}</th>
                          <th>{tr.results.match}</th>
                          <th>{tr.results.score}</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        {matches.map((m: Match) => {
                          const quarters = getQuarters(m);
                          return (
                            <tr class={getRowClass(m)} data-match-id={m._id}>
                              <td>{formatTime(m.datetime)}</td>
                              <td>
                                <span
                                  class={`pill ${m.court === "Court 1" ? "pill--h1" : "pill--h2"}`}
                                >
                                  {courts[m.court] ?? m.court ?? "—"}
                                </span>
                              </td>
                              <td>
                                <div style="font-weight: 700;">
                                  {m.teamA?.name ?? "?"} –{" "}
                                  {m.teamB?.name ?? "?"}
                                </div>
                                {m.matchType &&
                                  m.matchType !== "group" &&
                                  (matchTypes[m.matchType] ||
                                    m.matchType) && (
                                    <div
                                      class="muted"
                                      style="font-size: 11px; font-weight: normal; margin-top: 2px;"
                                    >
                                      {matchTypes[m.matchType] ??
                                        m.matchType}
                                    </div>
                                  )}
                                {m.matchType === "group" && m.group && (
                                  <div
                                    class="muted"
                                    style="font-size: 11px; font-weight: normal; margin-top: 2px;"
                                  >
                                    {locale === "en"
                                      ? "Group"
                                      : locale === "pl"
                                        ? "Grupa"
                                        : "Skupina"}{" "}
                                    {m.group}
                                  </div>
                                )}
                              </td>
                              <td class="col-score">
                                <div class="score-main">{getScore(m)}</div>
                                {quarters && (
                                  <div class="qscore" style="margin-top: 4px;">
                                    <table
                                      class="quarters"
                                      style="font-size: 11px; opacity: 0.7;"
                                    >
                                      <thead>
                                        <tr>
                                          {quarters.map((_: any, i: number) => (
                                            <th style="padding: 1px 6px; text-align:center;">
                                              Q{i + 1}
                                            </th>
                                          ))}
                                        </tr>
                                      </thead>
                                      <tbody>
                                        <tr>
                                          {quarters.map((q: any) => (
                                            <td style="padding: 1px 6px; text-align:center;">
                                              {q.scoreA ?? "—"}
                                            </td>
                                          ))}
                                        </tr>
                                        <tr>
                                          {quarters.map((q: any) => (
                                            <td style="padding: 1px 6px; text-align:center;">
                                              {q.scoreB ?? "—"}
                                            </td>
                                          ))}
                                        </tr>
                                      </tbody>
                                    </table>
                                  </div>
                                )}
                              </td>
                              <td class="col-status" set:html={getStatusBadge(m, locale)} />
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                </section>
              ),
          )}
        </>
      )
    }
  </main>
</Layout>

<style>
  .live-refresh-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 14px;
    padding: 10px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--sh-sm);
  }

  .live-refresh-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
  }

  .live-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #34c759;
    box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.7);
    animation: livePulseAnim 1.8s infinite;
  }

  @keyframes livePulseAnim {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(52, 199, 89, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 8px rgba(52, 199, 89, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(52, 199, 89, 0);
    }
  }

  .live-refresh-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .live-refresh-time {
    font-size: 12px;
    color: var(--muted);
  }

  .btn--small {
    padding: 6px 12px;
    font-size: 12px;
    border-radius: 8px;
    cursor: pointer;
  }
</style>

<script is:inline define:vars={{ cat, locale, refreshingText: tr.results.refreshing }}>
  (function () {
    const timeEl = document.getElementById("liveLastTime");
    const refreshBtn = document.getElementById("liveRefreshBtn");
    const intervalMs = 30000; // 30 sekund
    let isFetching = false;

    function updateTimestamp() {
      if (timeEl) {
        timeEl.textContent = new Date().toLocaleTimeString(
          locale === "cs" ? "cs-CZ" : locale === "pl" ? "pl-PL" : "en-US",
          { hour: "2-digit", minute: "2-digit", second: "2-digit" }
        );
      }
    }

    updateTimestamp();

    async function fetchMatches() {
      if (isFetching) return;
      isFetching = true;
      if (refreshBtn) {
        refreshBtn.setAttribute("disabled", "true");
        refreshBtn.textContent = refreshingText;
      }

      try {
        const res = await fetch(`/api/matches?cat=${cat}&t=${Date.now()}`);
        if (!res.ok) throw new Error("Fetch error: " + res.status);
        const data = await res.json();
        
        if (data.matches && Array.isArray(data.matches)) {
          data.matches.forEach((m) => {
            const row = document.querySelector(`tr[data-match-id="${m._id}"]`);
            if (!row) return;

            // Aktualizace stavové třídy
            row.classList.remove("is-live", "is-fin");
            if (m.status === "live") {
              row.classList.add("is-live");
            } else if (m.status === "finished" || (m.scoreA != null && m.scoreB != null)) {
              row.classList.add("is-fin");
            }

            // Aktualizace skóre
            const scoreMain = row.querySelector(".score-main");
            if (scoreMain) {
              if (m.scoreA != null && m.scoreB != null) {
                scoreMain.textContent = `${m.scoreA} : ${m.scoreB}`;
              } else if (m.status === "live") {
                scoreMain.textContent = "0 : 0";
              } else {
                scoreMain.textContent = "—";
              }
            }

            // Aktualizace status badge
            const statusCell = row.querySelector(".col-status");
            if (statusCell) {
              if (m.status === "live") {
                statusCell.innerHTML = '<span class="badge badge--live">LIVE</span>';
              } else if (m.status === "finished" || (m.scoreA != null && m.scoreB != null)) {
                const finLabel = locale === "en" ? "FT" : locale === "pl" ? "KONIEC" : "KONEC";
                statusCell.innerHTML = `<span class="badge badge--fin">${finLabel}</span>`;
              } else {
                statusCell.innerHTML = '<span class="badge">—</span>';
              }
            }
          });
        }
        updateTimestamp();
      } catch (err) {
        console.warn("Live refresh failed:", err);
      } finally {
        isFetching = false;
        if (refreshBtn) {
          refreshBtn.removeAttribute("disabled");
          refreshBtn.textContent = locale === "en" ? "Refresh now" : locale === "pl" ? "Odśwież teraz" : "Obnovit nyní";
        }
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener("click", () => fetchMatches());
    }

    // Automatický polling každých 30 sekund
    setInterval(fetchMatches, intervalMs);
  })();
</script>
