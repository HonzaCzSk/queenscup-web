---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { getGalleries } from "../lib/queries";
import { t, getLang } from "../i18n/index";

interface Props {
  lang: string;
  cat: "u12" | "u13" | "u14";
}

const { lang } = Astro.props;
const locale = getLang(lang);
const tr = t(locale);

const cat = (Astro.url.searchParams.get("cat") ?? "u12") as
  "u12" | "u13" | "u14";

const galleries = await getGalleries(cat);

const dayLabel = (day: number) => {
  const labels: Record<string, Record<number, string>> = {
    cs: {
      0: "Celý turnaj",
      1: "Den 1 – Pátek",
      2: "Den 2 – Sobota",
      3: "Den 3 – Neděle",
    },
    en: {
      0: "Full tournament",
      1: "Day 1 – Friday",
      2: "Day 2 – Saturday",
      3: "Day 3 – Sunday",
    },
    pl: {
      0: "Cały turniej",
      1: "Dzień 1 – Piątek",
      2: "Dzień 2 – Sobota",
      3: "Dzień 3 – Niedziela",
    },
  };
  return labels[locale]?.[day] ?? "";
};

const openAlbum =
  locale === "cs"
    ? "Otevřít album"
    : locale === "pl"
      ? "Otwórz album"
      : "Open album";
const byPhotographer =
  locale === "cs" ? "Fotograf" : locale === "pl" ? "Fotograf" : "Photographer";
const noGalleries =
  locale === "cs"
    ? "Fotografie budou k dispozici brzy po skončení turnaje."
    : locale === "pl"
      ? "Zdjęcia będą dostępne wkrótce po zakończeniu turnieju."
      : "Photos will be available shortly after the tournament.";
---

<Layout
  title={tr.photos.title}
  activePage="photos"
  activeCategory={cat}
  lang={lang}
>
  <main class="wrap">
    <section class="pagehead">
      <h1 class="h1">{tr.photos.title}</h1>
      <p class="lead">{tr.photos.desc}</p>
    </section>

    {
      galleries.length === 0 ? (
        <section class="card card--empty">
          <p class="card--empty__text">{noGalleries}</p>
        </section>
      ) : (
        <div class="photos-grid">
          {galleries.map((g: any) => (
            <a href={g.url} target="_blank" rel="noopener" class="photo-card">
              <div
                class={`photo-card__thumb ${!g.thumbnail ? "photo-card__thumb--empty" : ""}`}
              >
                {g.thumbnail ? (
                  <img src={g.thumbnail} alt={g.title} loading="lazy" />
                ) : (
                  <span class="photo-card__thumb-icon">📷</span>
                )}
              </div>
              <div class="photo-card__body">
                {g.day > 0 && (
                  <div class="photo-card__day">{dayLabel(g.day)}</div>
                )}
                <div class="photo-card__title">{g.title}</div>
                {g.photographer && (
                  <div class="photo-card__meta">
                    <span class="photo-card__label">{byPhotographer}:</span>{" "}
                    {g.photographer}
                  </div>
                )}
                <div class="photo-card__cta">{openAlbum} ↗</div>
              </div>
            </a>
          ))}
        </div>
      )
    }
  </main>
</Layout>
