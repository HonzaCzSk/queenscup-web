---
import Layout from "../layouts/Layout.astro";
import { getArchive } from "../lib/archive";

// 1. Získáme rok a kategorii z URL (výchozí je 2026 a u12)
const yearParam = Astro.url.searchParams.get("year") || "2026";
const catParam = Astro.url.searchParams.get("cat") || "u12";
const year = parseInt(yearParam, 10);

// 2. Natáhneme data ze Supabase pro daný rok a kategorii
const { tournament, teams, matches } = await getArchive(year, catParam);
---

<Layout
    title={`Archiv ročníku ${year}`}
    activePage="archive"
    activeCategory={catParam}
    lang="cs"
>
    <main class="wrap" style="padding: 40px 0;">
        <h1 class="h1" style="margin-bottom: 20px;">Archiv turnajů</h1>

        {/* Selektor ročníků */}
        <div style="display: flex; gap: 10px; margin-bottom: 30px;">
            <a
                href={`/archiv?year=2026&cat=${catParam}`}
                class={`btn ${year === 2026 ? "btn--primary" : "btn--ghost"}`}
            >
                2026
            </a>
            {
                /* Až bude další rok, jen sem připneš další tlačítko, např. 2027 */
            }
        </div>

        {/* Výpis dat turnaje */}
        {
            tournament ? (
                <div class="archive-content">
                    <div style="background: rgba(255,255,255,0.03); padding: 20px; border-radius: 8px; margin-bottom: 30px;">
                        <h2>{tournament.name}</h2>
                        <p class="muted">
                            Místo: {tournament.location} | Termín:{" "}
                            {tournament.start_date} až {tournament.end_date}
                        </p>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 30px;">
                        {/* Seznam týmů */}
                        <div>
                            <h3>Týmy v kategorii ({teams.length})</h3>
                            <ul style="list-style: none; padding: 0; margin-top: 10px;">
                                {teams.map((team: any) => (
                                    <li style="padding: 10px; background: rgba(255,255,255,0.02); margin-bottom: 8px; border-radius: 6px; display: flex; justify-content: space-between;">
                                        <span>
                                            <strong>{team.name}</strong> (
                                            {team.country})
                                        </span>
                                        <span
                                            class="muted"
                                            style="font-size: 13px;"
                                        >
                                            Hala: {team.venue}
                                        </span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        {/* Seznam zápasů */}
                        <div>
                            <h3>Zápasy a výsledky</h3>
                            <ul style="list-style: none; padding: 0; margin-top: 10px;">
                                {matches.length > 0 ? (
                                    matches.map((match: any) => (
                                        <li style="padding: 10px; background: rgba(255,255,255,0.02); margin-bottom: 8px; border-radius: 6px;">
                                            <div>
                                                {new Date(
                                                    match.datetime,
                                                ).toLocaleString("cs-CZ")}
                                            </div>
                                            <div style="font-weight: bold; margin-top: 4px;">
                                                Skóre: {match.scoreA ?? "-"} :{" "}
                                                {match.scoreB ?? "-"}
                                            </div>
                                        </li>
                                    ))
                                ) : (
                                    <p class="muted">
                                        Zatím žádné zápasy v archivu.
                                    </p>
                                )}
                            </ul>
                        </div>
                    </div>
                </div>
            ) : (
                <div style="padding: 40px; text-align: center;" class="muted">
                    Pro ročník {year} a kategorii {catParam.toUpperCase()} nebyl
                    nalezen žádný turnaj.
                </div>
            )
        }
    </main>
</Layout>
