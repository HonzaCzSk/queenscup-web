      mapsUrl: "https://maps.google.com/?q=TJ+Sokol+Hradec+Králové",
      courts: "Court 1 (hala główna) · Court 2 (hala treningowa)",
      stream: null,
    },
  },
  u13: {
    cs: {
      dates: "4. – 6. září 2026",
