---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";
import { t, getLang } from "../i18n/index";

interface Props {
  lang: string;
  cat: "u12" | "u13" | "u14";
}

const { lang, cat } = Astro.props;
const locale = getLang(lang);
const tr = t(locale);

// Specifické info pro každou kategorii
const catInfo = {
  u12: {
